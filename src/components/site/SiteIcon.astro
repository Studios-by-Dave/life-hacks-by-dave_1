---
/**
 * Maps a short icon name (stored in configuration files) to a Lucide component.
 * Keeping names in config means new pillars can be added without importing
 * components into data files.
 */
import {
  House,
  Shirt,
  Sprout,
  Zap,
  Stethoscope,
  Cross,
  Compass,
  Telescope,
  Orbit,
  Atom,
  Feather,
  ScrollText,
  Microscope,
  Sparkles,
  Droplets,
  Wind,
  Lightbulb,
  WavesHorizontal,
} from '@lucide/astro';

interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 22, class: className, strokeWidth = 1.6 } = Astro.props;

const registry: Record<string, any> = {
  house: House,
  shirt: Shirt,
  sprout: Sprout,
  zap: Zap,
  stethoscope: Stethoscope,
  cross: Cross,
  compass: Compass,
  telescope: Telescope,
  orbit: Orbit,
  atom: Atom,
  feather: Feather,
  scroll: ScrollText,
  microscope: Microscope,
  sparkles: Sparkles,
  droplets: Droplets,
  wind: Wind,
  lightbulb: Lightbulb,
  waves: WavesHorizontal,
};

const Icon = registry[name] ?? Compass;
---

<Icon size={size} stroke-width={strokeWidth} class={className} aria-hidden="true" />
